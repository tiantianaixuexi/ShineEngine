{
  "name": "EngineLauncher",
  "dirs": [
    "Program/launch"
  ],
  "deps": [
    "fmt",
    "shine_define",
    "imgui",
    "engine_log",
    "log_ui",
    "file_util"
  ],
  "defines": [
    "LAUNCHER_BUILD",
    "SHINE_OPENGL"
  ],
  "type": [
    "exe"
  ],
  "platform": [
    "Windows"
  ],
  "link": {
    "debug": {
      "lib": [
        "glew32d.lib"
      ]
    },
    "release": {
      "lib": [
        "glew32.lib"
      ]
    }
  },
  "output": "exe/EngineLauncher.exe"
}
